.tabbar-shell {
  position: fixed;
  z-index: 90;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 10rpx 18rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d5c9b8;
  background: rgba(253, 252, 249, .98);
  box-shadow: 0 -12rpx 34rpx rgba(74, 58, 39, .12);
}

.tabbar-rule {
  position: absolute;
  top: 0;
  right: 32rpx;
  left: 32rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #c97b3c 22%, #c97b3c 78%, transparent);
  opacity: .7;
}

.tabbar-inner {
  display: flex;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  gap: 10rpx;
}

.tabbar-item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 86rpx;
  gap: 12rpx;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  color: #625d55;
  transition: color .18s ease, background-color .18s ease, border-color .18s ease;
}

.tabbar-item-hover {
  background: #f4eee5;
}

.tabbar-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid #aaa095;
  border-radius: 8rpx;
  color: #776f65;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.tabbar-label {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.tabbar-indicator {
  position: absolute;
  bottom: 5rpx;
  left: 50%;
  width: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: #b85438;
  transform: translateX(-50%);
  transition: width .18s ease;
}

.tabbar-item.is-selected {
  border-color: #d8a06f;
  color: #8f3428;
  background: #f3e4d2;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, .65);
}

.tabbar-item.is-selected .tabbar-seal {
  border-color: #a94031;
  color: #ffffff;
  background: #b84b37;
  box-shadow: 0 4rpx 10rpx rgba(130, 54, 40, .2);
}

.tabbar-item.is-selected .tabbar-label {
  font-weight: 700;
}

.tabbar-item.is-selected .tabbar-indicator {
  width: 54rpx;
}
