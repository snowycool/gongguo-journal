.ledger-tabs {
  display: flex;
  margin-top: 28rpx;
  overflow: hidden;
  border: 2rpx solid #c97b3c;
  border-radius: 12rpx;
  background: #fffaf3;
}

.ledger-page .ledger-tab {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  width: 0;
  min-width: 0;
  min-height: 80rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  border-radius: 0;
  color: #ad642c;
  background: #fffaf3;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.ledger-page .ledger-tab + .ledger-tab {
  border-left: 1rpx solid #c97b3c;
}

.ledger-page .ledger-tab.active {
  color: #ffffff;
  background: #d78645;
}

.ledger-page .ledger-tab-hover {
  opacity: .82;
}

.ledger-panel {
  margin-top: 26rpx;
  overflow: hidden;
  border: 1rpx solid #dcd9d2;
  border-radius: 12rpx;
  background: #fdfcf9;
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 108rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #e1ded8;
  background: #efede8;
}

.ledger-page .toolbar-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 128rpx;
  gap: 8rpx;
  width: 128rpx;
  min-width: 0;
  min-height: 72rpx;
  margin: 0;
  padding: 8rpx;
  border: 1rpx solid #c97b3c;
  border-radius: 12rpx;
  color: #ad642c;
  background: #faeddc;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.4;
  white-space: nowrap;
}

.ledger-page .toolbar-button-hover {
  background: #f0dcc3;
}

.toolbar-arrow {
  font-family: sans-serif;
  font-size: 34rpx;
  line-height: 1;
}

.toolbar-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.month-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #e4e1db;
  background: #fbfaf7;
}

.month-net {
  font-family: Georgia, serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.month-count {
  margin-left: auto;
  min-width: 136rpx;
  color: #8a857d;
  font-size: 23rpx;
  text-align: right;
}

.weekdays,
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.weekdays {
  padding: 16rpx 10rpx 10rpx;
  border-bottom: 1rpx solid #ece9e3;
}

.weekdays text,
.calendar-cell {
  width: 14.285714%;
  text-align: center;
}

.weekdays text {
  color: #8a857d;
  font-size: 23rpx;
}

.calendar-grid {
  padding: 10rpx 10rpx 18rpx;
}

.calendar-cell {
  padding: 6rpx 4rpx;
}

.day-tile {
  position: relative;
  min-height: 84rpx;
  padding: 8rpx 2rpx 4rpx;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
}

.has-entry .day-tile.positive {
  border-color: #91b297;
  background: #edf3e8;
}

.has-entry .day-tile.negative {
  border-color: #c99b90;
  background: #f8ece7;
}

.has-entry .day-tile.zero {
  border-color: #c4ad84;
  background: #f4eee2;
}

.calendar-cell-hover .day-tile {
  opacity: .72;
}

.day-number,
.day-net {
  display: block;
}

.day-number {
  color: #4e4b46;
  font-family: sans-serif;
  font-size: 25rpx;
  line-height: 1.3;
}

.calendar-cell.today .day-number {
  color: #c97b3c;
  font-weight: 600;
}

.today-dot {
  position: absolute;
  top: 43rpx;
  left: 50%;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #c97b3c;
  transform: translateX(-50%);
}

.day-net {
  margin-top: 8rpx;
  color: #aaa69f;
  font-family: sans-serif;
  font-size: 23rpx;
  line-height: 30rpx;
}

.day-tile.positive .day-net { color: #4f7466; }
.day-tile.negative .day-net { color: #a95847; }
.day-tile.zero .day-net { color: #9a713d; }

.day-detail-arrow {
  position: absolute;
  top: 2rpx;
  right: 3rpx;
  font-family: sans-serif;
  font-size: 26rpx;
  line-height: 1;
}

.calendar-hint {
  padding: 20rpx 16rpx 0;
  border-top: 1rpx solid #e4e1db;
  color: #8a857d;
  font-size: 22rpx;
  text-align: center;
}

.calendar-hint + .legend {
  padding-top: 14rpx;
  border-top: 0;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx 24rpx;
  padding: 22rpx 16rpx;
  border-top: 1rpx solid #e4e1db;
  color: #8a857d;
  font-size: 22rpx;
}

.legend-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #b8b5ae;
}

.legend-dot.good { background: #4f7466; }
.legend-dot.fault { background: #a95847; }
.legend-dot.even { background: #9a713d; }

.year-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx 0;
  padding: 26rpx;
}

.ledger-page .year-month {
  box-sizing: border-box;
  position: relative;
  width: 32%;
  min-height: 164rpx;
  margin: 0;
  padding: 20rpx 8rpx;
  min-width: 0;
  border: 1rpx solid #d4b18c;
  border-radius: 10rpx;
  color: #4e4b46;
  background: #fffaf3;
  font-family: inherit;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
}

.ledger-page .year-month.current {
  border-color: #c97b3c;
  background: #f5e6d4;
}

.ledger-page .year-month-hover {
  background: #f0dcc3;
}

.year-month-arrow {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  color: #ad642c;
  font-family: sans-serif;
  font-size: 30rpx;
  line-height: 1;
}

.year-month.current::before {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 4rpx;
  background: #e39a5b;
  content: "";
}

.year-month-name,
.year-month-net,
.year-month-count {
  display: block;
}

.year-month-name {
  color: #ad642c;
  font-size: 24rpx;
  font-weight: 600;
}

.year-month-net {
  margin-top: 10rpx;
  font-family: Georgia, serif;
  font-size: 40rpx;
  font-weight: 700;
}

.year-month-count {
  margin-top: 8rpx;
  color: #8a857d;
  font-size: 20rpx;
}

.detail-sheet {
  min-height: 58vh;
}

.detail-list {
  display: flex;
  flex-direction: column;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e3e0da;
}

.detail-item text:last-child {
  flex: 0 0 auto;
  color: #8a857d;
  font-size: 24rpx;
}

.detail-empty {
  padding: 26rpx 0;
  color: #8a857d;
}

@media (max-width: 360px) {
  .ledger-page .year-month {
    width: 49%;
  }
}
