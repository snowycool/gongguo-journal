.ledger-tabs {
  display: flex;
  gap: 46rpx;
  margin-top: 28rpx;
  border-bottom: 1rpx solid #dcd9d2;
}

.ledger-tab {
  position: relative;
  width: auto;
  min-height: 82rpx;
  margin: 0;
  padding: 0 6rpx;
  border-radius: 0;
  color: #8a857d;
  background: transparent;
  font-size: 28rpx;
  line-height: 82rpx;
  letter-spacing: 4rpx;
}

.ledger-tab.active {
  color: #242321;
}

.ledger-tab.active::before {
  position: absolute;
  right: 0;
  bottom: -1rpx;
  left: 0;
  height: 4rpx;
  background: #e39a5b;
  content: "";
}

.ledger-panel {
  margin-top: 26rpx;
  overflow: hidden;
  border: 1rpx solid #dcd9d2;
  border-radius: 8rpx;
  background: #fdfcf9;
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 1rpx solid #e1ded8;
  background: #efede8;
}

.toolbar-button {
  flex: 0 0 150rpx;
  min-height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  color: #6d6962;
  background: transparent;
  font-size: 25rpx;
  line-height: 84rpx;
}

.toolbar-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 2rpx;
}

.month-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #e4e1db;
  background: #fbfaf7;
}

.month-net {
  margin-left: auto;
  font-family: Georgia, serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.month-count {
  min-width: 136rpx;
  color: #8a857d;
  font-size: 23rpx;
  text-align: right;
}

.weekdays,
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.weekdays {
  padding: 16rpx 10rpx 10rpx;
  border-bottom: 1rpx solid #ece9e3;
}

.weekdays text,
.calendar-cell {
  width: 14.285714%;
  text-align: center;
}

.weekdays text {
  color: #8a857d;
  font-size: 23rpx;
}

.calendar-grid {
  padding: 10rpx 10rpx 18rpx;
}

.calendar-cell {
  min-height: 112rpx;
  padding: 13rpx 2rpx 8rpx;
  border-radius: 4rpx;
}

.calendar-cell.today {
  box-shadow: inset 0 0 0 2rpx rgba(227, 154, 91, .72);
  background: #f5f1ea;
}

.day-number,
.day-net {
  display: block;
}

.day-number {
  color: #4e4b46;
  font-family: sans-serif;
  font-size: 25rpx;
  line-height: 1.3;
}

.day-net {
  width: 54rpx;
  min-height: 40rpx;
  margin: 9rpx auto 0;
  border-radius: 4rpx;
  color: #aaa69f;
  background: #f0eee8;
  font-family: sans-serif;
  font-size: 23rpx;
  line-height: 40rpx;
}

.day-net.positive { background: rgba(79, 116, 102, .09); }
.day-net.negative { background: rgba(169, 88, 71, .08); }
.day-net.zero { background: rgba(154, 113, 61, .08); }

.legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx 24rpx;
  padding: 22rpx 16rpx;
  border-top: 1rpx solid #e4e1db;
  color: #8a857d;
  font-size: 22rpx;
}

.legend-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #b8b5ae;
}

.legend-dot.good { background: #4f7466; }
.legend-dot.fault { background: #a95847; }
.legend-dot.even { background: #9a713d; }

.year-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 26rpx;
}

.year-month {
  position: relative;
  width: calc(33.333333% - 11rpx);
  min-height: 164rpx;
  margin: 0;
  padding: 20rpx 8rpx;
  border: 1rpx solid #e1ded8;
  border-radius: 6rpx;
  background: #fbfaf7;
  line-height: 1.4;
}

.year-month.current::before {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 4rpx;
  background: #e39a5b;
  content: "";
}

.year-month-name,
.year-month-net,
.year-month-count {
  display: block;
}

.year-month-name {
  color: #8a857d;
  font-size: 24rpx;
}

.year-month-net {
  margin-top: 10rpx;
  font-family: Georgia, serif;
  font-size: 40rpx;
  font-weight: 700;
}

.year-month-count {
  margin-top: 8rpx;
  color: #8a857d;
  font-size: 20rpx;
}

.detail-sheet {
  min-height: 58vh;
}

.detail-list {
  display: flex;
  flex-direction: column;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e3e0da;
}

.detail-item text:last-child {
  flex: 0 0 auto;
  color: #8a857d;
  font-size: 24rpx;
}

.detail-empty {
  padding: 26rpx 0;
  color: #8a857d;
}

@media (max-width: 360px) {
  .year-month {
    width: calc(50% - 8rpx);
  }
}
